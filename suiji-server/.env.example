# 岁记服务端环境变量（开源项目：.env 含真实凭据不入库，仅 .env.example 纳入版本管理）
#
# 用法说明：
#   1. docker compose 部署：compose 读取 .env 做变量插值，未设置的项用 compose 中的默认值；
#   2. 直接运行（python app/main.py）：只有「应用配置」与「直连运行入口」两组生效，
#      「部署/端口」「数据库凭据」两组仅 docker compose 使用（其中 DATABASE_URL 以直连为准）。
# 修改端口后注意联动：改 MINIO_PORT 要同步改 MINIO_PUBLIC_URL；
# 改 FILE_MAX_BYTES 要同步改 NGINX_CLIENT_MAX_BODY_SIZE，否则大文件被 nginx 拦在 413。
# 改完本文件后请同步 .env.example，两份保持逐行一致（compose 报错提示里指向的就是 .env）。

# ---- 部署与端口（仅 docker compose 使用；格式均为「宿主端口」，容器端口固定） ----
# 持久化数据的公共根目录，其下会生成 postgres/ minio/ media/ 三个子目录
DATA_DIR=./data
# 统一入口 nginx 对宿主暴露的端口（容器内端口由 NGINX_LISTEN_PORT 决定）
NGINX_PORT=30080
# nginx 容器内监听端口，一般保持 80；宿主 80 被占用时可改成 30080 等，映射会自动跟随
NGINX_LISTEN_PORT=80
# nginx 允许的请求体上限，需与 FILE_MAX_BYTES 对齐（默认 200MB）
NGINX_CLIENT_MAX_BODY_SIZE=200m
# api 直连端口（调试用，正常走 nginx；客户端地址填 http://<host>:<NGINX_PORT>/api/v1）
# 宿主 8000 已被本地 python app/main.py 占用，改为 8000 避免端口冲突
API_PORT=8000
# 数据库对宿主暴露的端口（默认 5432，避开本机已装的 5432）
POSTGRES_PORT=5432
# Redis 端口（仅容器内网使用，compose 默认不映射到宿主；调试时临时放开 127.0.0.1 绑定）
REDIS_PORT=6379
# MinIO 对宿主暴露的端口：API 端点与控制台
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# 启动探测 nginx 网关的地址（GET /healthz）；留空时自动尝试 compose 内网 http://nginx/healthz
# 与本机直连 http://127.0.0.1:30080/healthz（改过 NGINX_PORT / NGINX_LISTEN_PORT 时在此显式指定）
NGINX_PROBE_URL=

# ---- 数据库 / Redis 凭据（仅 docker compose 使用，compose 据此拼装 api 的 DATABASE_URL） ----
#
# ⚠️ 下面 4 项全部是占位符，部署前必须替换成随机值：
#     python -c "import secrets;print(secrets.token_urlsafe(24))"
# 本文件是模板（.env.example），不要写真实密钥进去——它会进版本库，
# 密钥一旦提交过 git 历史就必须轮换，删文件也没用。
POSTGRES_USER=suiji
POSTGRES_PASSWORD=REPLACE_ME_WITH_RANDOM_24
POSTGRES_DB=suiji
# Redis 访问密码（compose 同时用于 --requirepass 与 api 的 REDIS_URL；含 @ : / 需 URL 编码）
REDIS_PASSWORD=REPLACE_ME_WITH_RANDOM_24
# MinIO root 凭据：MINIO_ROOT_PASSWORD 与 api 侧的 MINIO_SECRET_KEY 必须一致（api 以 root 身份登录）
MINIO_ROOT_USER=suiji
MINIO_ROOT_PASSWORD=REPLACE_ME_WITH_RANDOM_24
# 注意：密码含 @ : / 等字符时需做 URL 编码后再填（如 @ 写成 %40）
# 以上三项密码均无 compose 兜底默认值：.env 缺失时 compose 直接报错，不会用公开占位密码启动

# ---- 应用配置（compose 与直连运行共用） ----
# JWT 签名密钥（HS256 对称：泄露即可伪造任意用户令牌，务必随机且定期轮换）
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
# 留空或仍是占位值时，生产部署（SUIJI_ALLOW_FALLBACK=0）会直接拒绝启动。
JWT_SECRET=change-me-in-prod
# 数据库连接串：compose 内由 POSTGRES_* 拼装；直连运行用 5432 映射端口，开发可改 sqlite
# 改 POSTGRES_PASSWORD 时这里要同步改（两处是独立配置，compose 不会回写本文件）
DATABASE_URL=postgresql+psycopg://suiji:REPLACE_ME_WITH_RANDOM_24@localhost:5432/suiji
# 启动时自动执行 Alembic 迁移（alembic upgrade head，判存幂等可重复执行）：
# 0=不迁移（默认，表结构由启动建表兜底；缺列的老库需手动跑迁移）
# 1=每次启动自动迁移到最新版本（推荐生产开启）
RUN_MIGRATIONS=0
# Redis（幂等键去重 + 会话撤销账本：登出/轮换/改密即时生效）；不可用时自动降级进程内存。
# 容器部署由 compose 注入内网地址；直连运行（python app/main.py）用本机地址——
# redis 服务默认不再映射宿主端口，连不上时会降级内存（单副本无碍，多副本需放开 127.0.0.1 映射）
REDIS_URL=redis://:REPLACE_ME_WITH_RANDOM_24@localhost:6379/0
# 媒体落盘目录（MediaStore local 实现，MEDIA_BACKEND=local 时生效；compose 内固定为 /app/data/media）
MEDIA_DIR=./data/media
# 非结构化文件存储后端：local=本地磁盘，minio=MinIO/S3 对象存储（compose 默认 minio）
# 容器部署必须保持 minio：设成 local 时文件只落进 data/media 卷，MinIO 控制台里永远看不到，
# 但接口照样返回成功（这正是"上传成功却看不到文件"的原因）
MEDIA_BACKEND=minio
# MinIO 连接信息（docker-compose 内置 minio 服务；外网 QUIC/HTTPS 场景把 SECURE 置 true）
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD 已在上面「凭据」区统一定义（两处不能重复，否则后者覆盖前者）
# 容器内直连地址（compose 网络内为 minio:9000）；直连运行填宿主地址 localhost:9000
# 注意：api 容器内 localhost 指向容器自身，填 localhost:9000 连不上 MinIO，
# 配合 SUIJI_ALLOW_FALLBACK 还会静默降级回本地磁盘，MinIO 里同样看不到文件
MINIO_ENDPOINT=minio:9000
# api 侧访问键：必须与 MINIO_ROOT_USER / MINIO_ROOT_PASSWORD 完全一致，否则桶操作鉴权失败
MINIO_ACCESS_KEY=suiji
MINIO_SECRET_KEY=REPLACE_ME_WITH_RANDOM_24
MINIO_BUCKET=suiji
MINIO_SECURE=false
# 桶所在区域，自建 MinIO 留空
MINIO_REGION=
# 自定义域名（虚拟主机寻址），一般留空
MINIO_DOMAIN=
# 客户端实际能访问到的对象存储地址，留空则由服务端代理回源下载
# 改 MINIO_PORT 后这里要跟着改（nginx 已不再转发 /minio，必须是客户端可直连的地址）
MINIO_PUBLIC_URL=http://localhost:9000
# 预签名 URL 有效期（秒）
MEDIA_URL_EXPIRES=600
# 下载方式：auto（有对外地址走 307 预签名，否则服务端代理）/ redirect / proxy
# 客户端直连不到 MINIO_PORT 时保持 proxy：
# proxy 由服务端回源字节，绕开预签名 + Host 校验这一整套问题。
MEDIA_DOWNLOAD_MODE=proxy
# 对象路径 {family_id}/{日期}/{文件名} 中的日期：默认服务器本地日期，置 1 取 UTC
MEDIA_PATH_DATE_UTC=0
# 单个非结构化文件上限（字节，/files 与 /media 共用 local/minio 后端）
FILE_MAX_BYTES=209715200
# LLM（OpenAI 兼容 chat/completions）；任一项为空则日记走模板兜底，Key 绝不下发客户端
# ⚠️ 不要把真实 Key 写进本文件：.env.example 会进版本库。
#    如果这个文件或 .env 里的 Key 曾经被提交过 git，请立即到厂商后台轮换，
#    删除文件也洗不掉 git 历史里的记录。
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.5-flash

# ---- 直接运行入口（python app/main.py）的启动参数 ----
# 监听地址 / 端口 / 是否热重载（RELOAD=0 关闭）
HOST=0.0.0.0
PORT=8000
RELOAD=1
# 外部依赖（数据库、对象存储）不可用时的降级开关：
# 1=降级到本地实现（SQLite / 本地磁盘，仅本地开发用），0=直接报错（生产/容器部署建议 0）
# 容器部署设 0：MinIO 连不上时立刻报错，而不是悄悄把文件写回本地磁盘
SUIJI_ALLOW_FALLBACK=0

# ---- 安全相关（compose 与直连运行共用） ----
# /docs、/openapi.json 的 IP 白名单（仅 docker compose + nginx 使用）。
# 默认 127.0.0.1 = 公网不可访问；临时调试时改成自己的公网 IP，用完改回来。
NGINX_ADMIN_ALLOW=all
# 是否信任反向代理的 X-Real-IP / X-Forwarded-For（限流按真实客户端 IP 计数）。
# 部署在 nginx 之后置 1；直接暴露 api 时必须置 0，否则伪造该头即可绕过限流。
TRUST_PROXY=1
# 密码最小长度（注册 / 改密共用）
PASSWORD_MIN_LENGTH=8
# 无鉴权端点的限流配额：RL_<名称>=次数，RL_<名称>_WINDOW=窗口秒
RL_REGISTER=5
RL_REGISTER_WINDOW=3600
RL_LOGIN=10
RL_LOGIN_WINDOW=300
RL_JOIN=10
RL_JOIN_WINDOW=300
RL_UPLOAD=60
RL_UPLOAD_WINDOW=300
# 预签名 URL 有效期的服务端硬上限（秒）：客户端传多大都不会超过它
MEDIA_URL_MAX_EXPIRES=3600
# CORS 白名单（逗号分隔，如 https://app.example.com）。
# 留空 = 不启用 CORS：App / 小程序不需要（不发起 CORS 请求），H5 与接口同源也不需要。
# H5 用独立开发服务器（如 Vite 的 http://localhost:5173）跨域调试时必须配上，
# 否则浏览器一律报 blocked by CORS policy。填 "*" 表示放行所有来源（仅开发用）。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 传输加密（应用层端到端：RSA-OAEP-256 封装会话密钥 + AES-256-CBC/HMAC-SHA256）----
# 客户端与服务端之间是明文 HTTP，口令 / 令牌 / 邀请码 / 导出数据在链路上裸奔；
# 这一层让链路被看穿也拿不到明文（详见 app/core/crypto.py 头注释）。
# off=关闭；optional=接受加密请求也放行明文（默认，兼容旧客户端与冒烟脚本）；
# required=敏感接口必须加密，明文一律 400 —— 客户端全量升级后务必改成 required，
# 否则中间人剥掉 X-Sj-Enc 头就能强制降级成明文。
CRYPTO_MODE=optional
# RSA 私钥落盘位置：首次启动自动生成（权限 600），请随 data/ 一起备份
CRYPTO_KEY_FILE=./data/crypto/app_rsa_private.pem
# 请求时间戳允许偏移（秒）：同时挡重放与客户端时钟严重偏移
CRYPTO_TS_WINDOW=300

# ---- 内置管理员账号（服务启动自动写入数据库，幂等；已存在则只补标记不重置密码）----
# 管理员（is_admin=1）在「我的」页可见普通成员看不到的演示/运维入口
# （首次引导流程、重置首次安装标记、启动加载动画、服务器地址、控件样式演示）。
# 生产部署请把 ADMIN_INIT_PASSWORD 改成自定义强口令（仅首次创建时生效，改库密码后这里不再覆盖）。
ADMIN_USERNAME=admin
ADMIN_INIT_PASSWORD=REPLACE_ME_WITH_STRONG_PASSWORD

# 岁记服务端环境变量 —— 通用占位模板（已按环境拆分，见下）
#
# 本文件仅作字段总览，不再直接用于 compose 启动。两套环境分别使用：
#
#   开发：cp .env.dev.example .env.dev
#         docker compose -f docker-compose.yml -f docker-compose.dev.yml --env-file .env.dev up -d
#   生产：cp .env.prod.example .env.prod
#         docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d
#
# 直连运行（python app/main.py）时读取根目录 .env；字段含义与两份分环境模板一致。
# 修改端口后注意联动：改 MINIO_PORT 要同步改 MINIO_PUBLIC_URL；
# 改 FILE_MAX_BYTES 要同步改 NGINX_CLIENT_MAX_BODY_SIZE，否则大文件被 nginx 拦在 413。

# ---- 部署与端口（仅 docker compose 使用；格式均为「宿主端口」，容器端口固定） ----
DATA_DIR=./data
NGINX_PORT=30080
NGINX_LISTEN_PORT=80
NGINX_CLIENT_MAX_BODY_SIZE=200m
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
NGINX_PROBE_URL=

# ---- 数据库 / Redis / MinIO 凭据（必填强随机值，缺失时 compose 拒绝启动） ----
POSTGRES_USER=suiji
POSTGRES_PASSWORD=REPLACE_ME_WITH_RANDOM_24
POSTGRES_DB=suiji
REDIS_PASSWORD=REPLACE_ME_WITH_RANDOM_24
MINIO_ROOT_USER=suiji
MINIO_ROOT_PASSWORD=REPLACE_ME_WITH_RANDOM_24

# ---- 应用配置 ----
JWT_SECRET=REPLACE_ME_WITH_RANDOM_48
DATABASE_URL=postgresql+psycopg://suiji:REPLACE_ME_WITH_RANDOM_24@localhost:5432/suiji
# Postgres 连接池上限（留空即取默认 10/30/1800，仅非 SQLite 生效）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=30
DB_POOL_RECYCLE=1800
RUN_MIGRATIONS=0
REDIS_URL=redis://:REPLACE_ME_WITH_RANDOM_24@localhost:6379/0
MEDIA_DIR=./data/media
MEDIA_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=suiji
MINIO_SECRET_KEY=REPLACE_ME_WITH_RANDOM_24
MINIO_BUCKET=suiji
MINIO_SECURE=false
MINIO_REGION=
MINIO_DOMAIN=
MINIO_PUBLIC_URL=http://localhost:9000
MEDIA_URL_EXPIRES=600
MEDIA_DOWNLOAD_MODE=proxy
MEDIA_PATH_DATE_UTC=0
FILE_MAX_BYTES=209715200
SUIJI_ALLOW_FALLBACK=0
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.5-flash

# ---- 直接运行入口（python app/main.py） ----
HOST=0.0.0.0
PORT=8000
RELOAD=1

# ---- 安全相关 ----
NGINX_ADMIN_ALLOW=127.0.0.1
TRUST_PROXY=1
# /metrics 指标端点开关；生产由 nginx 白名单（NGINX_ADMIN_ALLOW + 私网段）限制访问
METRICS_ENABLED=1
PASSWORD_MIN_LENGTH=8
RL_REGISTER=5
RL_REGISTER_WINDOW=3600
RL_LOGIN=10
RL_LOGIN_WINDOW=300
RL_JOIN=10
RL_JOIN_WINDOW=300
RL_UPLOAD=60
RL_UPLOAD_WINDOW=300
RL_PRESIGN=240
RL_PRESIGN_WINDOW=300
MEDIA_URL_MAX_EXPIRES=3600
CORS_ORIGINS=

# ---- 传输加密 ----
CRYPTO_MODE=optional
CRYPTO_KEY_FILE=./data/crypto/app_rsa_private.pem
CRYPTO_TS_WINDOW=300

# ---- 内置管理员账号 ----
ADMIN_USERNAME=admin
ADMIN_INIT_PASSWORD=REPLACE_ME_WITH_STRONG_PASSWORD

# 岁记服务端 —— 开发环境变量模板（local dev）
#
# 用法：
#   cp .env.dev.example .env.dev
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml --env-file .env.dev up -d
#
# 本文件中的密码仅用于本机/内网开发，可直接沿用；生产凭据见 .env.prod.example。
# .env.dev 含本地调试配置，不入库（见 .gitignore）。

# ---- 部署与端口（宿主端口，容器端口固定） ----
# 开发数据走 Docker 具名卷（见 docker-compose.dev.yml 末尾 volumes），不落地到项目目录；
# DATA_DIR / MEDIA_DIR 仅直连运行（python app/main.py）时使用，容器部署不读取。
# 宿主端口从 30000 起顺延，避开本机其他服务占用（容器内端口不变）：
#   30000=nginx 入口  30001=api  30002=postgres  30003=redis
NGINX_PORT=30000
NGINX_LISTEN_PORT=80
NGINX_CLIENT_MAX_BODY_SIZE=200m
API_PORT=30001
POSTGRES_PORT=30002
REDIS_PORT=30003
NGINX_PROBE_URL=

# ---- 数据库 / Redis 凭据（开发弱随机值，可直接用） ----
POSTGRES_USER=suiji
POSTGRES_PASSWORD=KDIQ2c7vy49iCfcSLSh5_zvELkoTsaSN
POSTGRES_DB=suiji_dev
REDIS_PASSWORD=fHNMy8W64YSSJghWZ4xkSHoJOp9Nxb7-

# ---- 应用配置 ----
# 开发可留空（config.py 会生成一次性随机密钥，重启后需重新登录）；这里给一个固定值方便会话保持
JWT_SECRET=nbTs4NCqIyr3qKzmu8QW5T7ORXsa07iELUUaHOeTajDQUYLF5mJznsaNnXfWwNrz
# 容器内由 compose 拼装，直连调试时才需要改下面两行
DATABASE_URL=postgresql+psycopg://suiji:KDIQ2c7vy49iCfcSLSh5_zvELkoTsaSN@localhost:30002/suiji_dev
REDIS_URL=redis://:fHNMy8W64YSSJghWZ4xkSHoJOp9Nxb7-@localhost:30003/0
RUN_MIGRATIONS=1
MEDIA_DIR=./data/media
MEDIA_BACKEND=local
# ---- 腾讯云 COS（S3 兼容）：仅 MEDIA_BACKEND=cos 时填，开发用 local 可留空 ----
COS_ENDPOINT=
COS_ACCESS_KEY=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-beijing
COS_PUBLIC_URL=
MEDIA_URL_EXPIRES=600
MEDIA_DOWNLOAD_MODE=proxy
MEDIA_PATH_DATE_UTC=0
FILE_MAX_BYTES=209715200
# 视频单段上限：大小（字节）与时长（秒）；前端选片拦截与服务端兜底取同一阈值
VIDEO_MAX_BYTES=52428800
VIDEO_MAX_SECONDS=30
# 开发允许降级：依赖挂掉时回退 SQLite / 本地磁盘继续调试
SUIJI_ALLOW_FALLBACK=1

# LLM（开发可留空，日记走模板兜底；真实 Key 不要写进会入库的模板）
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.5-flash

# ---- 安全相关（开发放宽） ----
# 开发放开 swagger 文档局域网访问
NGINX_ADMIN_ALLOW=all
TRUST_PROXY=1
PASSWORD_MIN_LENGTH=8
RL_REGISTER=5
RL_REGISTER_WINDOW=3600
RL_LOGIN=10
RL_LOGIN_WINDOW=300
RL_JOIN=10
RL_JOIN_WINDOW=300
RL_UPLOAD=60
RL_UPLOAD_WINDOW=300
RL_PRESIGN=240
RL_PRESIGN_WINDOW=300
MEDIA_URL_MAX_EXPIRES=3600
# H5 开发服务器跨域（Vite 5173/5174 被占用时自动退端口，两个都列上）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ---- 传输加密 ----
# 开发保持 optional：冒烟脚本与旧客户端明文请求不被拦
CRYPTO_MODE=optional
CRYPTO_KEY_FILE=./data/crypto/app_rsa_private.pem
CRYPTO_TS_WINDOW=300

# ---- 内置管理员账号（开发弱口令，仅本机用） ----
ADMIN_USERNAME=admin
ADMIN_INIT_PASSWORD=admin12345

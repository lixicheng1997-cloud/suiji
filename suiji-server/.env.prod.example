# 岁记服务端 —— 生产环境变量模板（production）
#
# 用法：
#   cp .env.prod.example .env.prod
#   逐项替换下面所有 REPLACE_ME_* 占位符（必须是强随机值）
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d
#
# ⚠️ 本文件只含占位符，不要把真实密钥写进来——它会进版本库。
#    密钥一旦提交过 git 历史就必须轮换，删文件也洗不掉历史记录。
# 生成随机值：
#   密码：python -c "import secrets;print(secrets.token_urlsafe(24))"
#   JWT：python -c "import secrets;print(secrets.token_urlsafe(48))"

# ---- 部署与端口（宿主端口，容器端口固定） ----
# 生产正式数据目录，务必纳入备份；不要与开发目录混用
DATA_DIR=./data
NGINX_PORT=30080
NGINX_LISTEN_PORT=80
NGINX_CLIENT_MAX_BODY_SIZE=200m
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
NGINX_PROBE_URL=

# ---- 数据库 / Redis / MinIO 凭据（必填强随机值，缺失时 compose 拒绝启动） ----
POSTGRES_USER=suiji
POSTGRES_PASSWORD=REPLACE_ME_WITH_RANDOM_24
POSTGRES_DB=suiji
REDIS_PASSWORD=REPLACE_ME_WITH_RANDOM_24
MINIO_ROOT_USER=suiji
MINIO_ROOT_PASSWORD=REPLACE_ME_WITH_RANDOM_24
# 注意：密码含 @ : / 等字符时需 URL 编码后再填（如 @ 写成 %40）

# ---- 应用配置 ----
# HS256 对称密钥：泄露即可伪造任意用户令牌，务必随机长密钥并定期轮换
JWT_SECRET=REPLACE_ME_WITH_RANDOM_48
# 容器内由 compose 拼装；直连调试时才需要改下面两行
DATABASE_URL=postgresql+psycopg://suiji:REPLACE_ME_WITH_RANDOM_24@localhost:5432/suiji
REDIS_URL=redis://:REPLACE_ME_WITH_RANDOM_24@localhost:6379/0
# 生产开启自动迁移（alembic upgrade head，判存幂等）
RUN_MIGRATIONS=1
MEDIA_DIR=./data/media
MEDIA_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=suiji
MINIO_SECRET_KEY=REPLACE_ME_WITH_RANDOM_24
MINIO_BUCKET=suiji
MINIO_SECURE=false
MINIO_REGION=
MINIO_DOMAIN=
# 客户端实际可访问的对象存储地址；nginx 未转发 /minio 时填对外可达地址
MINIO_PUBLIC_URL=http://localhost:9000
# ---- 腾讯云 COS（S3 兼容）：MEDIA_BACKEND=cos 时生效；minio 段可留空 ----
COS_ENDPOINT=https://cos.ap-beijing.myqcloud.com
COS_ACCESS_KEY=REPLACE_ME_COS_SECRETID
COS_SECRET_KEY=REPLACE_ME_COS_SECRETKEY
COS_BUCKET=suiji-1312293113
COS_REGION=ap-beijing
# 留空则用预签名里的 virtual-hosted 桶域名；绑自定义域名时填 https://你的域名
COS_PUBLIC_URL=
MEDIA_URL_EXPIRES=600
MEDIA_DOWNLOAD_MODE=proxy
MEDIA_PATH_DATE_UTC=0
FILE_MAX_BYTES=209715200
# 生产必须关闭降级：MinIO/Redis 不可用直接报错，不允许静默写回本地磁盘
SUIJI_ALLOW_FALLBACK=0

# LLM（Key 绝不下发客户端；不要把真实 Key 写进会入库的模板）
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.5-flash

# ---- 安全相关（生产收紧） ----
# 生产收紧文档访问：填固定出口 IP 或 CIDR（如 203.0.113.10/32）；默认 127.0.0.1 公网不可达
NGINX_ADMIN_ALLOW=127.0.0.1
TRUST_PROXY=1
# /metrics 指标端点；生产仅由 nginx 白名单（NGINX_ADMIN_ALLOW + 私网段）放行
METRICS_ENABLED=1
PASSWORD_MIN_LENGTH=8
RL_REGISTER=5
RL_REGISTER_WINDOW=3600
RL_LOGIN=10
RL_LOGIN_WINDOW=300
RL_JOIN=10
RL_JOIN_WINDOW=300
RL_UPLOAD=60
RL_UPLOAD_WINDOW=300
RL_PRESIGN=240
RL_PRESIGN_WINDOW=300
MEDIA_URL_MAX_EXPIRES=3600
# 生产关闭宽松跨域；H5 独立域名需要时显式列出具体来源（不要填 *）
CORS_ORIGINS=

# ---- 传输加密 ----
# 客户端全量升级后改为 required：敏感接口必须加密，明文一律 400，防中间人剥头降级
CRYPTO_MODE=optional
CRYPTO_KEY_FILE=./data/crypto/app_rsa_private.pem
CRYPTO_TS_WINDOW=300

# ---- 内置管理员账号（生产必须改成自定义强口令，仅首次创建时生效） ----
ADMIN_USERNAME=admin
ADMIN_INIT_PASSWORD=REPLACE_ME_WITH_STRONG_PASSWORD

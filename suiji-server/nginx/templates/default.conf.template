# 岁记服务端转发规则（docker-compose 的 nginx 服务挂载到 /etc/nginx/templates）
#
# 这是官方 nginx 镜像的 envsubst 模板：启动时按容器环境变量渲染后写入
# /etc/nginx/conf.d/default.conf，故所有可调项均为 ${VAR} 形式，取值来自 .env（见 .env.example）。
# 变量未设置时镜像不会替换，compose 中已为每个变量提供默认值，无需担心残留 ${}。
#
#   /api/v1/...              -> api:8000    业务接口（含 /files 上传、/files|/media 流式下载）
#   /docs /redoc             -> api:8000    OpenAPI 文档（离线资源在 /static-offline-docs）
#   /openapi.json            -> api:8000
#   /healthz                 -> nginx 自身存活探测（compose healthcheck 使用）
#   /suiji-website/          -> nginx 直接托管的官网静态站（挂载自 ./static/suiji-website）
#   /                        -> api:8000    服务标识（{"app":"suiji-server",...}）

# 未来接入 WebSocket / SSE 时按 Upgrade 头放行；无 Upgrade 时取空值，
# nginx 便不下发 Connection 头，从而保持 upstream keepalive 生效
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

# 容器网络内固定端口：api 容器 uvicorn 监听 8000，与宿主机映射端口无关
upstream suiji_api {
    server api:8000 max_fails=3 fail_timeout=10s;
    keepalive 32;
}

server {
    # 容器内监听端口（与 compose 的 "${NGINX_PORT}:${NGINX_LISTEN_PORT}" 右半部分一致）
    listen ${NGINX_LISTEN_PORT};
    server_name _;

    # 与 FILE_MAX_BYTES（默认 209715200 = 200MB）对齐，改 FILE_MAX_BYTES 时同步改这里，
    # 否则 nginx 默认 1m 会让上传直接 413（会覆盖 nginx.conf 中 http 级的同名兜底值）
    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

    # ---- 安全响应头（always 保证 4xx/5xx 也带上）----
    # nosniff 是下载端点的关键防线：禁止浏览器把用户上传的字节猜成 HTML 执行
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "DENY" always;
    add_header Referrer-Policy           "no-referrer" always;
    add_header Permissions-Policy        "geolocation=(), microphone=(), camera=()" always;
    add_header Content-Security-Policy   "default-src 'none'; frame-ancestors 'none'" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    # HSTS 只在 HTTPS 生效，放在 templates/tls.conf.template（默认未启用）里下发

    # ---- 限流 ----
    limit_conn conn_limit 50;
    limit_req  zone=api_limit burst=60 nodelay;

    # 反向代理通用头：api 侧据此还原客户端真实来源
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection        "";   # 配合 upstream keepalive
    proxy_connect_timeout 5s;
    proxy_send_timeout   300s;
    proxy_read_timeout   300s;

    # nginx 自身存活探测（不打到后端，后端故障不会让 nginx 被摘除）
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # 认证端点：注册/登录/刷新/邀请码加入不需要任何凭证就能打，配额必须最严，
    # 否则等于把撞库通道敞开（后端还有一层配额，这里是第一道）
    location /api/v1/auth/ {
        limit_req                zone=auth_limit burst=10 nodelay;
        proxy_pass               http://suiji_api;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location /api/v1/family/join {
        limit_req                zone=auth_limit burst=10 nodelay;
        proxy_pass               http://suiji_api;
    }

    # 业务接口：
    #  - proxy_buffering off：/api/v1/files/{id}/download 与 /api/v1/media/{id} 是 StreamingResponse，
    #    开缓冲会先在 nginx 落临时文件，视频/大图首字节延迟明显；
    #  - proxy_request_buffering off：200MB 上传边收边转给 api，避免 nginx 本地落盘。
    location /api/ {
        proxy_pass               http://suiji_api;
        proxy_buffering          off;
        proxy_request_buffering  off;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    # MinIO 对象存储直连通道：客户端通过 nginx 反代访问 MinIO，不再走 Python 回源。
    # 预签名 URL 由 FastAPI 用 MINIO_PUBLIC_URL 生成，指向本路径；nginx 透传到容器内 minio:9000。
    #  - proxy_set_header Host $http_host：MinIO 预签名把 Host 纳入签名计算，
    #    反代时必须保留原始 Host（公网域名），否则 SignatureDoesNotMatch。
    #  - expires：图片内容不可变（同一 storage_key 永远同字节），让浏览器缓存 7 天。
    #  - proxy_cache：nginx 层再缓存一层，多用户访问同一张图时只回源一次 MinIO。
    location /minio/ {
        proxy_pass               http://minio:9000/;
        proxy_set_header Host    $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version       1.1;
        proxy_set_header Connection "";

        # 浏览器缓存 7 天（预签名 URL 10 分钟过期，但对象内容不变；
        # 预签名参数每次不同，缓存 key 含完整 query，不会串号）
        expires                  7d;
        add_header               Cache-Control "public";

        # nginx 层缓存（需要在 http 块定义 proxy_cache_path，下面用内嵌映射）
        proxy_cache             minio_cache;
        proxy_cache_valid       200 7d;
        proxy_cache_use_stale    error timeout updating http_500 http_502 http_503;
        proxy_cache_lock        on;
    }

    # OpenAPI 文档与 fastapi-offline 的本地静态资源（/static-offline-docs/swagger-ui-bundle.js 等）。
    # 文档会列出全部接口与参数，公网可读等于把攻击面画成地图送给对方，所以只放行本地来源。
    #
    # 放行范围说明：Docker 里 nginx 看到的 $remote_addr 不是 127.0.0.1，而是
    # 网桥网关（172.17.0.1）或 Docker Desktop 的宿主地址（192.168.65.x），
    # 只写 127.0.0.1 会让本机浏览器访问也吃 403——这正是「本机访问却被拒」的原因。
    # 下面三段是 RFC1918 私网段，覆盖容器网桥与家庭/公司局域网；公网来源仍一律 403。
    # 额外的 IP 用 NGINX_ADMIN_ALLOW 追加（可写单个 IP 或 CIDR）。
    # 部署到公网服务器时，请把这三段收紧成自己的固定出口 IP。
    location ~ ^/(docs|redoc|openapi\.json|static-offline-docs)(/|$) {
        allow 127.0.0.1;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        allow ${NGINX_ADMIN_ALLOW};
        deny  all;
        # 覆盖 server 级的严格 CSP：swagger UI 要加载同域 JS/CSS 并跑内联脚本，
        # default-src 'none' 会让它整页白屏。注意 location 内一旦写 add_header，
        # server 级的全部不再继承，所以这里要写全套。
        #
        # 先 proxy_hide_header 剥掉上游（api 的 security_headers 中间件）下发的同名头，
        # 否则 nginx 的 add_header 是「追加」而非「替换」，同一个头会出现两份值
        # （如 content-security-policy: 'none'..., 'self'...）。多份 CSP 是「与」关系，
        # 只要其中一份是 'none' 就全盘拦死——这是 swagger 白屏的真正原因。
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Permissions-Policy;
        proxy_hide_header Content-Security-Policy;
        add_header X-Content-Type-Options    "nosniff" always;
        add_header X-Frame-Options           "SAMEORIGIN" always;
        add_header Referrer-Policy           "no-referrer" always;
        add_header Permissions-Policy        "geolocation=(), microphone=(), camera=()" always;
        add_header Content-Security-Policy   "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'" always;
        proxy_pass http://suiji_api;
    }

    location = / {
        proxy_pass http://suiji_api;
    }

    # ---- 官网静态站（岁记官网，随容器挂载在 /usr/share/nginx/html/suiji-website）----
    # 访问路径：/suiji-website/ ；安装包直链：/suiji-website/downloads/suiji-v1.0.0.apk
    # 裸路径 /suiji-website 补斜杠重定向，保证站内相对路径（assets/、downloads/）解析正确。
    # absolute_redirect off：容器内监听端口（80）与宿主映射端口（30080）不一致，
    # 默认生成的绝对 Location 会丢掉 :30080，必须用相对重定向
    location = /suiji-website {
        absolute_redirect off;
        return 301 /suiji-website/;
    }

    # 安装包直链：显式声明安卓包 MIME 并以 attachment 触发下载；
    # 文件名含版本号，换包即产生新 URL，故可放心缓存 30 天
    location ~ ^/suiji-website/(downloads/.+\.apk)$ {
        alias /usr/share/nginx/html/suiji-website/$1;
        default_type application/vnd.android.package-archive;
        add_header Content-Disposition "attachment";
        add_header Cache-Control "public, max-age=2592000";
        add_header X-Content-Type-Options "nosniff" always;
    }

    # 入口页不缓存，改版即时生效
    location = /suiji-website/index.html {
        alias /usr/share/nginx/html/suiji-website/index.html;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options    "nosniff" always;
        add_header Referrer-Policy           "no-referrer" always;
        add_header Content-Security-Policy   "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'self'" always;
    }

    # 站内其余静态资源（图片/字体/JS/CSS）缓存 7 天
    # location 内一旦写 add_header，server 级安全头不再继承，这里全套重写：
    # 官网需要加载同域 JS/CSS 与内联 style 属性，server 级 default-src 'none' 会白屏
    location /suiji-website/ {
        alias /usr/share/nginx/html/suiji-website/;
        index index.html;
        try_files $uri $uri/ /suiji-website/index.html;
        expires 7d;
        add_header Cache-Control "public";
        add_header X-Content-Type-Options    "nosniff" always;
        add_header Referrer-Policy           "no-referrer" always;
        add_header Permissions-Policy        "geolocation=(), microphone=(), camera=()" always;
        add_header Content-Security-Policy   "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'self'" always;
    }

    # 兜底：未匹配的路径一律拒绝，避免误暴露内部服务
    location / {
        return 404;
    }
}

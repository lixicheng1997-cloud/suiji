# 岁记服务端 HTTPS 入口（默认不启用）
#
# 本文件**默认不会被加载**：docker-compose 只挂载 default.conf.template。
# 启用步骤（三步）：
#   1. 申请证书（推荐 certbot）：
#        certbot certonly --standalone -d <你的域名>
#   2. docker-compose.yml 的 nginx 服务补两行挂载：
#        - ./nginx/templates/tls.conf.template:/etc/nginx/templates/tls.conf.template:ro
#        - /etc/letsencrypt/live/<你的域名>:/etc/nginx/certs:ro
#      并加端口映射 "${NGINX_TLS_PORT:-443}:443"
#   3. 重启 nginx。之后把对外地址改成 https://<域名>:<NGINX_TLS_PORT>/api/v1
#      （server_endpoint 表 / static/config/servers.json 与客户端「我的 → 服务器地址」同步更新），
#      否则 JWT、密码、宝宝健康数据仍然是明文过公网。
#
# 注意：启用后建议把 80 端口保留为跳转（见下方 server），不要直接关掉，
# 老客户端存的 http:// 地址会自动被带过去。

server {
    listen ${NGINX_TLS_LISTEN_PORT} ssl;
    http2 on;
    server_name ${NGINX_SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

    # HSTS：只在 HTTPS 下发才有意义（纯 HTTP 响应里的 HSTS 会被忽略）
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "DENY" always;
    add_header Referrer-Policy           "no-referrer" always;
    add_header Permissions-Policy        "geolocation=(), microphone=(), camera=()" always;
    add_header Content-Security-Policy   "default-src 'none'; frame-ancestors 'none'" always;

    limit_conn conn_limit 50;
    limit_req  zone=api_limit burst=60 nodelay;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection        "";
    proxy_connect_timeout 5s;
    proxy_send_timeout   300s;
    proxy_read_timeout   300s;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/v1/auth/ {
        limit_req                zone=auth_limit burst=10 nodelay;
        proxy_pass               http://suiji_api;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location /api/ {
        proxy_pass               http://suiji_api;
        proxy_buffering          off;
        proxy_request_buffering  off;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location ~ ^/(docs|redoc|openapi\.json|static-offline-docs)(/|$) {
        allow localhost;
        allow 127.0.0.1;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        allow ${NGINX_ADMIN_ALLOW};
        deny  all;
        proxy_pass http://suiji_api;
    }

    location / {
        return 404;
    }
}

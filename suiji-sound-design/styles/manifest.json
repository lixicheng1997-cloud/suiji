{
  "styles": [
    {
      "key": "bubble",
      "name": "软合成气泡风",
      "desc": "现代轻快、圆润 Q 弹，像主流系统 App 的提示音，干净中性。",
      "fit": "高频点击、年轻轻快的产品气质",
      "caution": "电子感偏强，温暖和怀旧感弱"
    },
    {
      "key": "marimba",
      "name": "木琴钟琴风",
      "desc": "明亮清脆的敲击旋律，音高明确，带童趣和阳光感。",
      "fit": "育儿 / 儿童向场景，辨识度高",
      "caution": "高频偏多，夜间或低端机需压低音量"
    },
    {
      "key": "piano",
      "name": "柔钢琴风",
      "desc": "柔和钢琴单双音，温暖经典、治愈百搭，最不容易出错。",
      "fit": "全场景通用，情绪稳妥",
      "caution": "辨识度一般，偏常规、少记忆点"
    },
    {
      "key": "musicbox",
      "name": "八音盒风",
      "desc": "细密金属齿轮音，带轻颤音和长尾韵，精致梦幻、纪念感强。",
      "fit": "里程碑、纪念卡等成就音",
      "caution": "做点击音会偏飘、偏长"
    },
    {
      "key": "drop",
      "name": "水滴气泡风",
      "desc": "短促水滴/气泡声，轻快可爱，几乎不占注意力。",
      "fit": "轻量点击、频繁交互",
      "caution": "成就音情绪偏轻，撑不起庆祝感"
    },
    {
      "key": "wood",
      "name": "木质打击风",
      "desc": "纯木块敲击、弱音高，极简克制，低调不打扰。",
      "fit": "夜间场景、追求安静克制",
      "caution": "缺少温度和记忆点，偏干涩"
    },
    {
      "key": "kalimba",
      "name": "当前 · 卡林巴木质风",
      "desc": "线上现有版本：拇指琴拨弦 + 木质敲击 + 气声尾，温润夜间感。",
      "fit": "对照基准",
      "caution": "即本次想要换掉的风格"
    }
  ],
